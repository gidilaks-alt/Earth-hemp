# PayPlus (Israeli payment gateway) — set these in Netlify:
# Site settings → Environment variables. Get your keys from the PayPlus
# dashboard after opening an account: https://www.payplus.co.il
#
# Test everything in the sandbox (PAYPLUS_ENV=sandbox) before switching
# to production — real cards will be charged in production mode.

PAYPLUS_API_KEY=
PAYPLUS_SECRET_KEY=
PAYPLUS_PAYMENT_PAGE_UID=
PAYPLUS_ENV=sandbox

# Your live site URL, no trailing slash (used for payment success/failure redirects)
SITE_URL=https://earthnhemp.netlify.app
